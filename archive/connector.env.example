# PLAUD connector — one tenant. Copy to connector.env and keep mode 0600.
TENANT_ID=tenant-alpha
ARCHIVE_TIMEZONE=UTC
COMPOSE_PROJECT_NAME=jazzuu-connector-tenant-alpha
TENANT_ARCHIVE_DIR=/tmp/jazzuu/archive
TENANT_CREDS_DIR=/tmp/jazzuu/creds
TENANT_CONTROL_DIR=/tmp/jazzuu/control
TENANT_CONTROL_TOKEN_FILE=/tmp/jazzuu/recordings-control-token

# Required allow-list. Each tenant ID maps to one unique HTTP(S) endpoint.
PLAUD_MCP_TENANT_URLS_JSON={"tenant-alpha":"https://mcp-alpha.example/mcp","tenant-beta":"https://mcp-beta.example/mcp"}
# Optional assertion; it cannot override the mapping.
PLAUD_MCP_EXPECTED_URL=https://mcp-alpha.example/mcp
# Required exact host allow-list for upstream presigned audio URLs. Redirects,
# non-HTTPS URLs, non-public destinations and responses over the byte cap fail closed.
PLAUD_AUDIO_DOWNLOAD_HOSTS=audio-storage.example
PLAUD_AUDIO_MAX_BYTES=8589934592
RECORDING_CODE_PREFIXES_JSON={"tenant-alpha":"A","tenant-beta":"B"}

ASR_MCP_URL=https://asr.example/mcp
ASR_TOKEN_FILE=/creds/asr-token
DIARIZATION_MODELS_DIR=/tmp/jazzuu/models/diarization
SYNC_INTERVAL_S=1800
MAX_PER_PASS=0
RUN_ASR=1
BUILD_VERSION=dev
