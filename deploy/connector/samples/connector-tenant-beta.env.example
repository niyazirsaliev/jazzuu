# Connector deployment for one tenant; this file contains no secrets.
TENANT_ID=tenant-beta
COMPOSE_PROJECT_NAME=jazzuu-connector-tenant-beta
TENANT_ARCHIVE_DIR=/srv/jazzuu/tenant-beta/archive
TENANT_CREDS_DIR=/srv/jazzuu/tenant-beta/credentials
TENANT_CONTROL_TOKEN_FILE=/srv/jazzuu/tenant-beta/control/recordings-control-token
TENANT_CONTROL_DIR=/srv/jazzuu/tenant-beta/control/socket
PLAUD_MCP_TENANT_URLS_JSON={"tenant-alpha":"https://mcp-alpha.example/mcp","tenant-beta":"https://mcp-beta.example/mcp"}
PLAUD_MCP_EXPECTED_URL=https://mcp-beta.example/mcp
ASR_MCP_URL=https://asr.example/mcp
ASR_AUDIO_PATH_PREFIX=/tenant-audio/tenant-beta
ASR_TOKEN_FILE=/creds/asr-token
DIARIZATION_MODELS_DIR=/srv/jazzuu/models/diarization
SYNC_INTERVAL_S=1800
MAX_PER_PASS=0
RUN_ASR=1
BUILD_VERSION=dev
