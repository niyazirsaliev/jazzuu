# Non-secret local-development example. Replace the magic secret in viewer/.env.
VIEWER_CONTAINER_NAME=jazzuu-viewer
TENANT_ID=tenant-alpha
VIEWER_PORT=8000
VIEWER_BIND_ADDR=127.0.0.1
TENANT_ARCHIVE_DIR=/tmp/jazzuu/archive
TENANT_CONTROL_TOKEN_FILE=/tmp/jazzuu/recordings-control-token
TENANT_CONTROL_DIR=/tmp/jazzuu/control
PUBLIC_SHARE_STORE_HOST=/tmp/jazzuu/public-shares
PUBLIC_SHARE_SECRET_FILE=/tmp/jazzuu/public-share-secret
PUBLIC_SHARE_ENABLED=0
RECORDINGS_MAGIC_SECRET=replace-with-a-random-secret
# Exact opt-out for this loopback HTTP example. Delete for HTTPS deployments.
VIEWER_DEVELOPMENT_INSECURE_COOKIE=1