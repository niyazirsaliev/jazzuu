# Single-tenant Recordings MCP deployment values; no credentials belong here.
RECORDINGS_MCP_IMAGE=jazzuu-recordings-mcp:latest
TENANT_ID=tenant-alpha
RECORDINGS_MCP_CODE_PREFIX=A
RECORDINGS_MCP_ARCHIVE_DIR=/tmp/jazzuu/archive
RECORDINGS_MCP_STATE_DIR=/tmp/jazzuu/mcp-state
RECORDINGS_MCP_BIND_ADDR=127.0.0.1
RECORDINGS_MCP_PUBLISH_PORT=62390
